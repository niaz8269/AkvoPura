# AkvoPura mobile — environment variables
# Copy this file to mobile/.env (gitignored) and set the values you need.
#
# Expo only reads env vars on startup, so after editing this file STOP
# and re-run `npx expo start`.

# Backend URL the app should hit. Leave UNSET in local development to
# fall back to the LAN_IP defined in src/api/config.ts. Set this only
# when you've deployed the backend to Render or another host.
#
# Example:
#   EXPO_PUBLIC_API_URL=https://akvopura-backend.onrender.com
EXPO_PUBLIC_API_URL=
