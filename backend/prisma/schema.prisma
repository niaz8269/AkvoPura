// AkvoPura backend schema.
// Slice B-1: just users + branches so /auth/login works end-to-end.
// Domain tables (customers, deliveries, etc.) come in later slices.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  manager
  pets_salesman
  cans_gallons_salesman
  production_worker
  driver
  helper
  other
  customer
}

enum CGRoute {
  hospital
  bypass
  others
}

enum PaymentCycle {
  daily
  weekly
}

enum ExpenseCategory {
  fuel
  food
  repairs
  utilities
  salary
  raw_material
  other
}

enum ExpenseStatus {
  pending
  approved
  rejected
  forwarded
}

enum ProducedProduct {
  pet600
  pet1500
  can
  gallon
}

enum RawMaterialUnit {
  pieces
  rolls
}

enum CustomerOrderStatus {
  pending
  assigned
  in_transit
  delivered
  cancelled
}

enum SubscriptionCadence {
  weekly
}

enum ComplaintCategory {
  delivery
  product_quality
  billing
  salesman_behavior
  other
}

enum ComplaintRecipient {
  salesman
  manager
}

enum ComplaintStatus {
  open
  in_review
  resolved
}

/// A physical branch / depot. Slug is the stable identifier used in
/// URLs and JWT payloads (e.g., 'timergara'). New branches can be added
/// at any time without code changes.
model Branch {
  slug         String       @id
  name         String
  nameUr       String?
  location     String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  users         User[]
  cgCustomers   CGCustomer[]
  petCustomers  PetCustomer[]
  expenses      Expense[]
  productionBatches ProductionBatch[]
  customerOrders CustomerOrder[]
  complaints    Complaint[]
  subscriptions Subscription[]

  @@map("branches")
}

/// Customer complaint — filed by a customer, addressed to either the
/// salesman who served them or the branch manager. Manager moves it
/// through review → resolved; the customer can rate after resolved.
model Complaint {
  id              String              @id @default(cuid())
  branchSlug      String
  branch          Branch              @relation(fields: [branchSlug], references: [slug])

  customerUserId  String
  /// Display-name snapshot at file time.
  customerName    String

  category        ComplaintCategory
  recipient       ComplaintRecipient
  description     String

  status          ComplaintStatus     @default(open)
  /// Customer rating 1-5, only set after resolved.
  rating          Int?

  filedAt         DateTime            @default(now())
  resolvedAt      DateTime?
  /// Manager / owner who decided.
  decidedById     String?
  updatedAt       DateTime            @updatedAt

  comments        ComplaintComment[]

  @@index([branchSlug, status])
  @@index([customerUserId, filedAt])
  @@map("complaints")
}

/// One reply on a complaint thread. Customer (own complaint) +
/// manager + owner can post.
model ComplaintComment {
  id           String     @id @default(cuid())
  complaintId  String
  complaint    Complaint  @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  authorId     String
  /// Display-name snapshot at post time.
  authorName   String
  authorRole   Role

  body         String

  postedAt     DateTime   @default(now())

  @@index([complaintId, postedAt])
  @@map("complaint_comments")
}

/// Customer-placed order. Items are stored as a JSON snapshot of
/// {productId, qty, unitPrice} so the order is self-contained and
/// historical pricing is preserved. Status moves through pending →
/// assigned → in_transit → delivered (or cancelled at any pre-delivery
/// step).
model CustomerOrder {
  id                  String              @id @default(cuid())
  branchSlug          String
  branch              Branch              @relation(fields: [branchSlug], references: [slug])

  customerUserId      String
  /// Denormalised display name at order time.
  customerName        String

  /// JSON: Array<{ productId: 'cans'|'gallons'|'pet600'|'pet1500', qty: number, unitPrice: number }>
  items               Json
  totalAmount         Int

  preferredTime       String?
  notes               String?

  status              CustomerOrderStatus @default(pending)
  assignedSalesmanId  String?
  /// Denormalised salesman name at assignment time.
  assignedSalesmanName String?

  /// Cancellation / decision note (manager).
  managerNote         String?

  placedAt            DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  /// Who last touched the row (customer cancel, manager decide,
  /// salesman in-transit/delivered).
  updatedById         String?

  @@index([branchSlug, status])
  @@index([customerUserId, placedAt])
  @@index([assignedSalesmanId, status])
  @@map("customer_orders")
}

/// Raw material inventory item (bottles, caps, stickers, wraps).
/// Currently global (no branch scope) — production happens at one
/// factory per branch but inventory is a single pool. Add branchSlug
/// later if needed.
model RawMaterial {
  id                String          @id
  name              String
  nameUr            String?
  currentStock      Int             @default(0)
  reorderThreshold  Int             @default(0)
  unit              RawMaterialUnit @default(pieces)
  updatedAt         DateTime        @updatedAt

  @@map("raw_materials")
}

/// One production batch — packs of pet600/pet1500 or filled cans/gallons.
/// On record, raw materials are deducted per the recipe in code (not in
/// the schema, so the recipe stays editable in app code).
model ProductionBatch {
  id            String          @id @default(cuid())
  branchSlug    String
  branch        Branch          @relation(fields: [branchSlug], references: [slug])

  product       ProducedProduct
  unitsProduced Int
  batchNumber   String

  /// Quality-control checkpoint values.
  tdsPpm        Int?
  phLevel       Float?
  /// Units lost / damaged in this batch.
  wastage       Int             @default(0)
  notes         String?

  loggedById    String
  /// Display name snapshot at log time.
  loggedByName  String

  loggedAt      DateTime        @default(now())

  @@index([branchSlug, loggedAt])
  @@index([branchSlug, product, loggedAt])
  @@map("production_batches")
}

/// Expense submitted by a salesman or manager. Manager approves /
/// rejects / forwards to the owner; owner sees forwarded items and
/// makes the final call.
model Expense {
  id              String          @id @default(cuid())
  branchSlug      String
  branch          Branch          @relation(fields: [branchSlug], references: [slug])

  submittedById   String
  /// Denormalised display name at submit time so the inbox renders
  /// without an extra join.
  submittedByName String
  submittedByRole Role

  category        ExpenseCategory
  amount          Int
  notes           String?

  status          ExpenseStatus   @default(pending)
  decisionNote    String?
  decidedById     String?

  submittedAt     DateTime        @default(now())
  decidedAt       DateTime?
  updatedAt       DateTime        @updatedAt

  @@index([branchSlug, status])
  @@index([branchSlug, submittedAt])
  @@map("expenses")
}

/// Pets customer — usually a small shop or domestic household that buys
/// disposable PET packs (600ml × 12 or 1.5L × 6). No empties, no
/// payment cycle — just a debt balance. Per-customer price overrides
/// fall back to global Pricing if null.
model PetCustomer {
  id              String   @id @default(cuid())
  name            String
  phone           String
  address         String
  /// Free text — Pets routes are flexible, not enum-constrained.
  area            String
  branchSlug      String
  branch          Branch   @relation(fields: [branchSlug], references: [slug])

  outstandingDebt Int      @default(0)
  pricePet600     Int?
  pricePet1500    Int?

  lastActivityAt  DateTime?

  active          Boolean  @default(true)
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bills           PetBill[]
  returns         PetReturn[]

  @@index([branchSlug, active])
  @@map("pet_customers")
}

/// One Pets bill (sale). Mutates the customer's outstanding debt.
model PetBill {
  id            String      @id @default(cuid())
  customerId    String
  customer      PetCustomer @relation(fields: [customerId], references: [id])
  salesmanId    String
  branchSlug    String

  pet600Packs   Int
  pet1500Packs  Int
  /// Subtotal before discount = packs * unit prices used at bill time.
  subtotal      Int
  /// Flat Rs amount discounted (0 if none).
  discount      Int         @default(0)
  /// Final amount the customer owes for this bill = subtotal - discount.
  amountBilled  Int
  /// Cash received in hand.
  cashCollected Int         @default(0)
  /// Money received via Easypaisa / JazzCash / IBFT / other digital.
  /// Treated identically to cash for the debt calculation.
  bankCollected Int         @default(0)
  /// Free-text reference for the digital payment (TXN id, sender name).
  paymentReference String?
  tripNumber    Int         @default(1)

  loggedAt      DateTime    @default(now())

  @@index([branchSlug, loggedAt])
  @@index([salesmanId, loggedAt])
  @@index([customerId, loggedAt])
  @@map("pet_bills")
}

/// One Pets return — packs come back, customer's debt is credited
/// (or cash refunded — for now just credit).
model PetReturn {
  id            String      @id @default(cuid())
  customerId    String
  customer      PetCustomer @relation(fields: [customerId], references: [id])
  salesmanId    String
  branchSlug    String

  pet600Packs   Int
  pet1500Packs  Int
  refundAmount  Int
  reason        String?
  tripNumber    Int         @default(1)

  loggedAt      DateTime    @default(now())

  @@index([branchSlug, loggedAt])
  @@index([salesmanId, loggedAt])
  @@index([customerId, loggedAt])
  @@map("pet_returns")
}

/// One delivery visit. Mutates the customer's empties + debt; the
/// delivery row itself is the audit trail.
model CGDelivery {
  id                    String     @id @default(cuid())
  customerId            String
  customer              CGCustomer @relation(fields: [customerId], references: [id])
  /// User who logged this delivery.
  salesmanId            String
  branchSlug            String

  cansDelivered         Int
  gallonsDelivered      Int
  emptyCansCollected    Int
  emptyGallonsCollected Int
  /// Cash received in hand.
  cashCollected         Int
  /// Money received via Easypaisa / JazzCash / IBFT / other digital.
  /// Treated identically to cash for the debt calculation.
  bankCollected         Int        @default(0)
  /// Free-text reference for the digital payment (TXN id, sender name).
  paymentReference      String?
  /// cans*price + gallons*price at delivery time, snapshotted.
  amountBilled          Int
  /// Which trip of the day (1, 2, ...).
  tripNumber            Int        @default(1)

  loggedAt              DateTime   @default(now())

  @@index([branchSlug, loggedAt])
  @@index([salesmanId, loggedAt])
  @@index([customerId, loggedAt])
  @@map("cg_deliveries")
}

/// One empties-collection visit (no money changes hands; only empties).
model CGCollection {
  id                String     @id @default(cuid())
  customerId        String
  customer          CGCustomer @relation(fields: [customerId], references: [id])
  salesmanId        String
  branchSlug        String

  cansCollected     Int
  gallonsCollected  Int

  /// Cash collected from the customer at this visit (often the moment
  /// the salesman comes back to pick up empties is also when payment
  /// changes hands, especially for weekly-cycle customers).
  cashCollected     Int        @default(0)
  /// Money received via Easypaisa / JazzCash / IBFT etc.
  bankCollected     Int        @default(0)
  /// Free-text reference for the digital payment (TXN id, sender name).
  paymentReference  String?

  tripNumber        Int        @default(1)

  loggedAt          DateTime   @default(now())

  @@index([branchSlug, loggedAt])
  @@index([salesmanId, loggedAt])
  @@index([customerId, loggedAt])
  @@map("cg_collections")
}

/// Cans / Gallons customer — a shop, hospital ward, or household that
/// receives reusable filled cans and gallons. Mutable balance fields
/// (empties held, outstanding debt) are updated by deliveries +
/// collections in a later slice.
model CGCustomer {
  id            String       @id @default(cuid())
  name          String
  phone         String
  address       String
  branchSlug    String
  branch        Branch       @relation(fields: [branchSlug], references: [slug])

  route         CGRoute
  paymentCycle  PaymentCycle

  /// Hint quantities used to auto-fill the delivery sheet.
  usualCans     Int          @default(0)
  usualGallons  Int          @default(0)

  /// Number of returnable empties currently with this customer.
  emptyCansHeld    Int       @default(0)
  emptyGallonsHeld Int       @default(0)

  /// Outstanding amount the customer owes (PKR).
  outstandingDebt Int        @default(0)

  /// Per-customer override prices.
  pricePerCan     Int
  pricePerGallon  Int

  /// Last delivery / activity timestamp. Null = never active.
  lastActivityAt  DateTime?

  /// Soft-delete flag. False = hidden from lists.
  active          Boolean    @default(true)

  notes           String?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  deliveries      CGDelivery[]
  collections     CGCollection[]

  @@index([branchSlug, active])
  @@index([branchSlug, route])
  @@map("cg_customers")
}

/// Global pricing + container fees. One row, scope='global'. Branch-
/// scoped overrides may come later — keep the scope column to leave the
/// door open without future schema changes.
model Pricing {
  id            String   @id @default(cuid())
  scope         String   @unique @default("global")

  pet600Price   Int      @default(280)
  pet1500Price  Int      @default(320)
  canPrice      Int      @default(280)
  gallonPrice   Int      @default(200)

  lostCanFee    Int      @default(600)
  lostGallonFee Int      @default(900)

  updatedAt     DateTime @updatedAt
  updatedBy     String?

  @@map("pricing")
}

/// Customer subscription — recurring order template that the daily cron
/// turns into pending CustomerOrder rows on matching days. Customers
/// create / pause / cancel from the customer portal; the manager just
/// sees the generated orders in their inbox (badged "From subscription").
model Subscription {
  id              String              @id @default(cuid())
  branchSlug      String
  branch          Branch              @relation(fields: [branchSlug], references: [slug])

  customerUserId  String
  /// Display-name snapshot at subscribe time.
  customerName    String

  /// JSON: Array<{ productId: 'cans'|'gallons'|'pet600'|'pet1500', qty: number, unitPrice: number }>
  /// unitPrice is snapshotted at create time so historical pricing is
  /// preserved if global pricing changes later. The cron does NOT
  /// re-price.
  items           Json

  cadence         SubscriptionCadence @default(weekly)
  /// Days the order should be generated. 0 = Sunday … 6 = Saturday
  /// (matches JS Date.getDay()).
  daysOfWeek      Int[]

  preferredTime   String?
  notes           String?

  /// Paused / cancelled subscriptions are skipped by the cron.
  active          Boolean             @default(true)

  /// Last date (yyyy-mm-dd) the cron generated an order from this
  /// subscription. Prevents duplicate generation if the cron runs
  /// twice the same day.
  lastGeneratedOn String?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([branchSlug, active])
  @@index([customerUserId])
  @@map("subscriptions")
}

model User {
  id           String   @id @default(cuid())
  identifier   String   @unique
  name         String
  passwordHash String
  role         Role

  /// Optional contact phone — populated for self-registered customers
  /// (managers need it to verify the registration) and for staff records.
  phone        String?

  branchSlug   String?
  branch       Branch?  @relation(fields: [branchSlug], references: [slug])

  /// Soft-delete flag. When false, login is blocked.
  active       Boolean  @default(true)

  /// False while a self-registered customer is waiting for their branch
  /// manager to approve. Login is blocked until this flips to true.
  /// Existing users (created by staff or seed) default to true.
  verified     Boolean  @default(true)

  /// When a customer self-registers they pick 'cg' or 'pets' so the
  /// manager knows which kind of customer record to create at verify time.
  /// Null for staff users and for already-verified customers.
  pendingCustomerKind String?

  // Customer-role users link to a CG customer record + a Pets customer
  // record. Auto-populated when an order is fulfilled if missing.
  linkedCgCustomerId  String?
  linkedPetCustomerId String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([branchSlug, verified])
  @@map("users")
}
