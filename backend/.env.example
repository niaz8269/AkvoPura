# AkvoPura backend — environment variables
# Copy this file to .env (gitignored) and fill in real values.
# In production (Render) these are set in the dashboard, not in this file.

# Postgres connection string. Local dev uses the docker-compose Postgres.
DATABASE_URL="postgresql://akvopura:akvopura_dev@localhost:5432/akvopura?schema=public"

# Secret used to sign JWT auth tokens.
# In production this MUST be a long random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="dev-secret-change-me-before-production"

# How long a login token stays valid. Salesman / manager phones stay
# logged in for ~30 days so they don't have to re-authenticate weekly.
JWT_EXPIRES_IN="30d"

# Port to listen on. Render injects its own PORT, so leave this unset in
# production.
PORT=3000
